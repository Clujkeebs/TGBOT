# Copy to .env and fill in - or run `python setup_env.py` to be walked through it.

# --- Telegram (required) ---
# From @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot). Comma-separate to allow several.
TELEGRAM_CHAT_ID=

# --- Solana RPC (required) ---
# A free Helius key works well: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# The public api.mainnet-beta.solana.com endpoint is heavily rate limited - avoid it.
SOLANA_RPC_URL=

# --- Wallet encryption (required) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP. Losing it means losing access to the hot wallet stored in the DB.
FERNET_KEY=

# --- Leader trade detection ---
# poll    = no server/domain needed (easiest, ~2s latency)
# webhook = Helius pushes trades to you (fastest, needs public HTTPS URL)
INGEST_MODE=poll
POLL_INTERVAL_S=2

# Only for INGEST_MODE=webhook:
HELIUS_API_KEY=
# Must end in a long random token, e.g. https://bot.example.com/webhook/3f9c...e1
HELIUS_WEBHOOK_URL=
HELIUS_WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# --- Jupiter (optional) ---
# Free key from https://portal.jup.ag (higher rate limits). Empty = keyless lite API.
JUPITER_API_KEY=

# --- Misc ---
DATABASE_URL=sqlite+aiosqlite:///./data/copybot.db
# DATABASE_URL=postgresql+asyncpg://copybot:password@127.0.0.1:5432/copybot
LOG_LEVEL=INFO
HOT_WALLET_MAX_SOL=5

# --- AI manager (optional) ---
# Key from https://console.anthropic.com. Enables AI buy screening, leader reviews and chat.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
